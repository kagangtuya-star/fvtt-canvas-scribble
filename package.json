{
  "name": "canvas-scribble",
  "version": "1.0.0",
  "private": true,
  "description": "CanvasScribble (随绘幕布) — instant drawing, annotation and presentation tools for Foundry VTT maps and screens.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning tools/build.mjs",
    "build:dev": "node --disable-warning=ExperimentalWarning tools/build.mjs --harness",
    "watch": "node --disable-warning=ExperimentalWarning tools/build.mjs --harness --watch",
    "package": "node --disable-warning=ExperimentalWarning tools/build.mjs && node tools/package.mjs",
    "harness": "node --disable-warning=ExperimentalWarning tools/build.mjs --harness",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"tools/**/*.mjs\" \"dev/**/*.{ts,html}\" \"styles/**/*.css\" \"lang/**/*.json\" module.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"tools/**/*.mjs\" \"dev/**/*.{ts,html}\" \"styles/**/*.css\" \"lang/**/*.json\" module.json",
    "lint:i18n": "node tools/check-i18n.mjs",
    "validate": "node tools/validate-manifest.mjs",
    "check": "npm run typecheck && npm run lint:i18n && npm test && npm run build && npm run validate"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lazy-brush": "2.0.2",
    "perfect-freehand": "1.2.3",
    "roughjs": "4.6.6",
    "simplex-noise": "4.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.10.1",
    "spectral.js": "3.0.0",
    "typescript": "7.0.2"
  }
}
